static class DashboardPanel extends JPanel {
        private JLabel welcomeLabel;
        
        public DashboardPanel() {
            initializeUI();
            refreshUserInfo();
        }
        
        private void initializeUI() {
            setLayout(new BorderLayout());
            
        
            JPanel header = new JPanel(new BorderLayout());
            header.setBackground(new Color(52, 152, 219));
            header.setPreferredSize(new Dimension(0, 80));
            
            welcomeLabel = new JLabel("Welcome!");
            welcomeLabel.setFont(new Font("Arial", Font.BOLD, 24));
            welcomeLabel.setForeground(Color.WHITE);
            welcomeLabel.setBorder(BorderFactory.createEmptyBorder(20, 20, 20, 20));
            
            JButton logoutBtn = new JButton("Logout");
            logoutBtn.addActionListener(e -> {
                SessionManager.getInstance().logout();
                showPanel("HOME");
            });
            
            header.add(welcomeLabel, BorderLayout.WEST);
            header.add(logoutBtn, BorderLayout.EAST);
            
            
            JPanel menuPanel = new JPanel(new GridLayout(3, 2, 20, 20));
            menuPanel.setBorder(BorderFactory.createEmptyBorder(50, 50, 50, 50));
            menuPanel.setBackground(Color.WHITE);
            
            JButton createGroupBtn = createMenuButton("Create Group", new Color(46, 204, 113));
            JButton joinGroupBtn = createMenuButton("Join Group", new Color(52, 152, 219));
            JButton addExpenseBtn = createMenuButton("Add Expense", new Color(241, 196, 15));
            JButton viewBalancesBtn = createMenuButton("View Balances", new Color(231, 76, 60));
            JButton myGroupsBtn = createMenuButton("My Groups", new Color(155, 89, 182));
            JButton profileBtn = createMenuButton("My Profile", new Color(52, 73, 94));
            
            createGroupBtn.addActionListener(e -> showPanel("CREATE_GROUP"));
            joinGroupBtn.addActionListener(e -> showPanel("JOIN_GROUP"));
            addExpenseBtn.addActionListener(e -> showPanel("ADD_EXPENSE"));
            viewBalancesBtn.addActionListener(e -> showPanel("VIEW_BALANCES"));
            myGroupsBtn.addActionListener(e -> showPanel("MY_GROUPS"));
            
            menuPanel.add(createGroupBtn);
            menuPanel.add(joinGroupBtn);
            menuPanel.add(addExpenseBtn);
            menuPanel.add(viewBalancesBtn);
            menuPanel.add(myGroupsBtn);
            menuPanel.add(profileBtn);
            
            add(header, BorderLayout.NORTH);
            add(menuPanel, BorderLayout.CENTER);
            
            setBackground(Color.WHITE);
        }
        
        public void refreshUserInfo() {
            User currentUser = SessionManager.getInstance().getCurrentUser();
            if (currentUser != null) {
                welcomeLabel.setText("Welcome, " + currentUser.getUsername() + "!");
            } else {
                welcomeLabel.setText("Welcome!");
            }
        }
        
        private JButton createMenuButton(String text, Color color) {
            JButton button = new JButton(text);
            button.setBackground(color);
            button.setForeground(Color.WHITE);
            button.setFont(new Font("Arial", Font.BOLD, 16));
            button.setFocusPainted(false);
            button.setBorderPainted(false);
            button.setPreferredSize(new Dimension(200, 100));
            return button;
        }
    }
    
    
    static class CreateGroupPanel extends JPanel {
        public CreateGroupPanel() {
            setLayout(new GridBagLayout());
            GridBagConstraints gbc = new GridBagConstraints();
            gbc.insets = new Insets(10, 10, 10, 10);
            
            JLabel title = new JLabel("Create New Group");
            title.setFont(new Font("Arial", Font.BOLD, 24));
            
            JTextField nameField = new JTextField(20);
            JTextField codeField = new JTextField(20);
            JTextField capacityField = new JTextField(20);
            JButton createBtn = new JButton("Create Group");
            JButton backBtn = new JButton("Back to Dashboard");
            
            gbc.gridy = 0; gbc.gridwidth = 2; add(title, gbc);
            gbc.gridy = 1; gbc.gridwidth = 1; add(new JLabel("Group Name:"), gbc);
            gbc.gridy = 2; gbc.gridx = 1; add(nameField, gbc);
            gbc.gridy = 3; gbc.gridx = 0; add(new JLabel("Group Code:"), gbc);
            gbc.gridy = 4; gbc.gridx = 1; add(codeField, gbc);
            gbc.gridy = 5; gbc.gridx = 0; add(new JLabel("Max Members:"), gbc);
            gbc.gridy = 6; gbc.gridx = 1; add(capacityField, gbc);
            gbc.gridy = 7; gbc.gridx = 0; add(createBtn, gbc);
            gbc.gridy = 7; gbc.gridx = 1; add(backBtn, gbc);
            
            backBtn.addActionListener(e -> showPanel("DASHBOARD"));
            
            createBtn.addActionListener(e -> {
                String name = nameField.getText().trim();
                String code = codeField.getText().trim();
                String capacityStr = capacityField.getText().trim();
                
                if (!Validator.isNotEmpty(name, code, capacityStr)) {
                    showError("Please fill all fields");
                    return;
                }
                
                try {
                    int capacity = Integer.parseInt(capacityStr);
                    Group group = new Group(name, code, SessionManager.getInstance().getCurrentUserEmail(), capacity);
                    
                    if (LocalStorage.saveGroup(group)) {
                        showSuccess("Group created successfully!");
                        showPanel("DASHBOARD");
                    } else {
                        showError("Failed to create group!");
                    }
                } catch (NumberFormatException ex) {
                    showError("Invalid capacity!");
                }
            });
            
            setBackground(Color.WHITE);
        }
    }
    
  
    static class JoinGroupPanel extends JPanel {
        public JoinGroupPanel() {
            setLayout(new GridBagLayout());
            GridBagConstraints gbc = new GridBagConstraints();
            gbc.insets = new Insets(10, 10, 10, 10);
            
            JLabel title = new JLabel("Join Group");
            title.setFont(new Font("Arial", Font.BOLD, 24));
            
            JTextField codeField = new JTextField(20);
            JButton joinBtn = new JButton("Join Group");
            JButton backBtn = new JButton("Back to Dashboard");
            
            gbc.gridy = 0; gbc.gridwidth = 2; add(title, gbc);
            gbc.gridy = 1; gbc.gridwidth = 1; add(new JLabel("Group Code:"), gbc);
            gbc.gridy = 2; gbc.gridx = 1; add(codeField, gbc);
            gbc.gridy = 3; gbc.gridx = 0; add(joinBtn, gbc);
            gbc.gridy = 3; gbc.gridx = 1; add(backBtn, gbc);
            
            backBtn.addActionListener(e -> showPanel("DASHBOARD"));
            
