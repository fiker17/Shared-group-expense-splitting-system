    static class AddExpensePanel extends JPanel {
        public AddExpensePanel() {
            setLayout(new GridBagLayout());
            GridBagConstraints gbc = new GridBagConstraints();
            gbc.insets = new Insets(10, 10, 10, 10);
            
            JLabel title = new JLabel("Add Expense");
            title.setFont(new Font("Arial", Font.BOLD, 24));
            
            JTextField descField = new JTextField(20);
            JTextField amountField = new JTextField(20);
            JTextField groupCodeField = new JTextField(20);
            JButton addBtn = new JButton("Add Expense");
            JButton backBtn = new JButton("Back to Dashboard");
            
            gbc.gridy = 0; gbc.gridwidth = 2; add(title, gbc);
            gbc.gridy = 1; gbc.gridwidth = 1; add(new JLabel("Description:"), gbc);
            gbc.gridy = 2; gbc.gridx = 1; add(descField, gbc);
            gbc.gridy = 3; gbc.gridx = 0; add(new JLabel("Amount:"), gbc);
            gbc.gridy = 4; gbc.gridx = 1; add(amountField, gbc);
            gbc.gridy = 5; gbc.gridx = 0; add(new JLabel("Group Code:"), gbc);
            gbc.gridy = 6; gbc.gridx = 1; add(groupCodeField, gbc);
            gbc.gridy = 7; gbc.gridx = 0; add(addBtn, gbc);
            gbc.gridy = 7; gbc.gridx = 1; add(backBtn, gbc);
            
            backBtn.addActionListener(e -> showPanel("DASHBOARD"));
            
            addBtn.addActionListener(e -> {
                String desc = descField.getText().trim();
                String amountStr = amountField.getText().trim();
                String groupCode = groupCodeField.getText().trim();
                
                if (!Validator.isNotEmpty(desc, amountStr, groupCode)) {
                    showError("Please fill all fields");
                    return;
                }
                
                if (!Validator.isValidAmount(amountStr)) {
                    showError("Please enter a valid positive amount");
                    return;
                }
                
                if (LocalStorage.saveExpense(desc, Double.parseDouble(amountStr), groupCode)) {
                    showSuccess("Expense added successfully!");
                    descField.setText("");
                    amountField.setText("");
                    groupCodeField.setText("");
                } else {
                    showError("Failed to add expense!");
                }
            });
            
            setBackground(Color.WHITE);
        }
    }
    
    
    static class ViewBalancesPanel extends JPanel {
        public ViewBalancesPanel() {
            setLayout(new BorderLayout());
            
            JLabel title = new JLabel("Group Balances");
            title.setFont(new Font("Arial", Font.BOLD, 24));
            title.setHorizontalAlignment(SwingConstants.CENTER);
            
            JTextArea balancesArea = new JTextArea(15, 40);
            balancesArea.setEditable(false);
            JScrollPane scrollPane = new JScrollPane(balancesArea);
            
            JPanel buttonPanel = new JPanel(new FlowLayout());
            JButton refreshBtn = new JButton("Refresh");
            JButton backBtn = new JButton("Back to Dashboard");
            
            refreshBtn.addActionListener(e -> refreshBalances(balancesArea));
            backBtn.addActionListener(e -> showPanel("DASHBOARD"));
            
            buttonPanel.add(refreshBtn);
            buttonPanel.add(backBtn);
            
            add(title, BorderLayout.NORTH);
            add(scrollPane, BorderLayout.CENTER);
            add(buttonPanel, BorderLayout.SOUTH);
            
            // Load initial data
            refreshBalances(balancesArea);
            
            setBackground(Color.WHITE);
        }
        
        private void refreshBalances(JTextArea area) {
            String report = LocalStorage.calculateBalances("TRIP2024");
            area.setText(report);
        }
    }
    
    
    static class MyGroupsPanel extends JPanel {
        public MyGroupsPanel() {
            setLayout(new BorderLayout());
            
            JLabel title = new JLabel("My Groups");
            title.setFont(new Font("Arial", Font.BOLD, 24));
            title.setHorizontalAlignment(SwingConstants.CENTER);
            
            JTextArea groupsArea = new JTextArea(15, 40);
            groupsArea.setEditable(false);
            JScrollPane scrollPane = new JScrollPane(groupsArea);
            
            JPanel buttonPanel = new JPanel(new FlowLayout());
            JButton refreshBtn = new JButton("Refresh");
            JButton backBtn = new JButton("Back to Dashboard");
            
            refreshBtn.addActionListener(e -> refreshGroups(groupsArea));
            backBtn.addActionListener(e -> showPanel("DASHBOARD"));
            
            buttonPanel.add(refreshBtn);
            buttonPanel.add(backBtn);
            
            add(title, BorderLayout.NORTH);
            add(scrollPane, BorderLayout.CENTER);
            add(buttonPanel, BorderLayout.SOUTH);
            
            // Load initial data
            refreshGroups(groupsArea);
            
            setBackground(Color.WHITE);
        }
        
        private void refreshGroups(JTextArea area) {
            StringBuilder sb = new StringBuilder();
            sb.append("=== MY GROUPS ===\n\n");
            
            java.util.List<Group> groups = LocalStorage.getUserGroups(SessionManager.getInstance().getCurrentUserEmail());
            
            if (groups.isEmpty()) {
                sb.append("You haven't joined any groups yet.\n");
                sb.append("Create a group or join an existing one to get started!");
            } else {
                for (Group group : groups) {
                    sb.append("Group: ").append(group.getName()).append("\n");
                    sb.append("Code: ").append(group.getCode()).append("\n");
                    sb.append("Members: ").append(group.getMemberEmails().size()).append("/").append(group.getCapacity()).append("\n");
                    sb.append("\n");
                }
            }
            
            area.setText(sb.toString());
        }
    }
}
